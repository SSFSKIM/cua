  "limitations": [
    {
      "case": "cells/native-pipe/connect-timeout",
      "notes": [
        "A full AF_UNIX backlog refuses immediately on both platforms. Live proof records the 1,000 ms setting and bounded refusal; socket-double unit proof covers timer expiry."
      ]
    },
    {
      "case": "cells/native-pipe/data-close-error",
      "notes": [
        "Real macOS abort is close-only (EOF wins); Linux emits error-before-close with os error 104 and late replay. Error-before-close and late error are boundary-double proof injected into the selected worker stdin, not the supervisor."
      ]
    }
  ],
