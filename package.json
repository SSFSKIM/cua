{
  "name": "cua",
  "version": "0.1.0",
  "private": true,
  "description": "Standalone MCP server for OpenAI's computer-use runtime on macOS.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "node --test \"test/**/*.test.mjs\"",
    "build:helper": "node scripts/build-helper.mjs",
    "test:helper": "node scripts/test-helper.mjs",
    "test:keychain-live": "node native/keychain/live/keychain-roundtrip.mjs"
  },
  "bin": {
    "cua": "bin/cua.mjs"
  },
  "files": [
    "bin/",
    "src/",
    "runtime/releases/",
    "native/keychain/Package.swift",
    "native/keychain/Sources/",
    "native/keychain/Tests/",
    "scripts/build-helper.mjs",
    "scripts/probe/lib.mjs",
    "cua-shim.mjs",
    "verify.mjs",
    ".claude-plugin/",
    "README.md"
  ],
  "dependencies": {
    "ws": "^8.22.0"
  }
}
