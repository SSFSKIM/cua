# Dependencies and build output
node_modules/

# Vendor runtime archives and extracted runtimes never enter git; tests and probes use a scratch CUA_HOME outside
# the repository.
*.zip
runtimes/
staging/
# npm run extension:pack output (the Store zip; with the owner's key the CRX and update.xml)
dist/
current.json

# Local secrets and machine state
.env
*.log
.DS_Store

# Written by Claude Code when it loads the hooks module from this folder (hooks/mods/tsconfig.json reads it)
.claude/

# doperpowers execution ledgers and review packages (local only)
.doperpowers/sde/

# The seatbelt golden generator's local links and build state (scripts/sandbox-golden/generate.sh)
scripts/sandbox-golden/upstream
scripts/sandbox-golden/Cargo.lock
scripts/sandbox-golden/target/

# scripts/sandbox-probe/hosted-gate.sh's reports (the ci-kit gate sandbox-live uploads them when it fails)
hosted-gate-out/

# SwiftPM build output (a `swift test` in the package; the build hash ignores it, src/runtime/engine-bundle.mjs)
native/engine/.build/
